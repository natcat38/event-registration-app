# Backend server
PORT=8000
CORS_ORIGIN=http://localhost:8001

# MySQL (matches docker-compose.yml)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=event_registration
DB_USER=app_user
DB_PASSWORD=app_password
DB_ROOT_PASSWORD=root_password

# OneMap API credentials. Register a free account: https://www.onemap.gov.sg/apidocs/register
# Required. The server refuses to start when either value is blank.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Optional. Set to true to enable the per-IP rate limit on POST /api/public/register.
RATE_LIMIT_ENABLED=false
